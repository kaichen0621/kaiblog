<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/"><channel><title>Partials on KAI BLOG</title><link>http://localhost:1313/partials/</link><description>Recent content in Partials on KAI BLOG</description><generator>Hugo</generator><language>zh-tw</language><atom:link href="http://localhost:1313/partials/index.xml" rel="self" type="application/rss+xml"/><item><title/><link>http://localhost:1313/partials/footer/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>http://localhost:1313/partials/footer/</guid><description>&lt;script&gt;
document.addEventListener("DOMContentLoaded", function() {
// 找出頁面上所有寫著 &lt;PaidContent&gt; 的元素
const contents = document.querySelectorAll("PaidContent, paidcontent, PaidContent01, paidcontent01");
contents.forEach((el, index) =&gt; {
const originalContent = el.innerHTML;
const id = el.getAttribute("id") || `paid-${index}`;
const storageKey = `kai_blog_unlocked_01_${id}`;
const CORRECT_PASSCODE = 'resolve';
const wrapper = document.createElement("div");
wrapper.style.cssText = "margin: 2.5rem 0; padding: 2.5rem 2rem; border-radius: 30px; border: 2px solid var(--border); background: var(--code-bg); text-align: center; box-sizing: border-box;";
function render(unlocked) {
if (unlocked) {
wrapper.style.border = "none";
wrapper.style.background = "transparent";
wrapper.style.padding = "0";
wrapper.innerHTML = originalContent;
} else {
wrapper.innerHTML = `
&lt;div style="font-size: 3rem; margin-bottom: 1rem;"&gt;⚠️&lt;/div&gt;
&lt;h3 style="font-size: 1.5rem; font-weight: 800; color: var(--primary); margin-bottom: 0.2rem; line-height: 1.4;"&gt;
目前停止開放下載！&lt;br /&gt;
&lt;span style="font-size: 1.5rem; color: #ee4242; font-weight: 900; margin-bottom: 0.8rem; display: inline-block;"&gt;請透過 Mail 聯繫&lt;/span&gt;
&lt;/h3&gt;
&lt;p style="font-size: 0.95rem; opacity: 0.8; margin-bottom: 1.5rem; font-weight: 500; line-height: 1.5; color: var(--secondary);"&gt;
輸入密碼才能查看&lt;br /&gt;
&lt;span style="font-size: 0.85rem; color: var(--primary); font-weight: bold;"&gt;💡 管理員專屬&lt;/span&gt;
&lt;/p&gt;
&lt;input type="password" class="lock-input" placeholder="5525+2 位數字密碼" style="width: 100%; max-width: 400px; padding: 12px; border-radius: 10px; border: 1px solid var(--border); background: rgba(0,0,0,0.05); color: var(--primary); font-size: 1.1rem; text-align: center; outline: none; margin-bottom: 10px; box-sizing: border-box;" /&gt;
&lt;p class="lock-error" style="color: #ff4d4f; font-size: 0.85rem; display: none; margin-bottom: 8px; font-weight: 700;"&gt;❌ 密碼錯誤&lt;/p&gt;
&lt;br /&gt;
&lt;button class="lock-btn" style="width: 100%; max-width: 400px; padding: 14px; font-size: 1rem; font-weight: 700; color: #383838; background: #ffdd00; border: none; border-radius: 20px; cursor: pointer; box-shadow: 0 4px 12px rgba(255, 221, 0, 0.25);"&gt;我是管理員！&lt;/button&gt;
`;
const input = wrapper.querySelector(".lock-input");
const btn = wrapper.querySelector(".lock-btn");
const errorMsg = wrapper.querySelector(".lock-error");
btn.addEventListener("click", () =&gt; {
if (input.value === CORRECT_PASSCODE) {
localStorage.setItem(storageKey, "true");
render(true);
} else {
errorMsg.style.display = "block";
setTimeout(() =&gt; errorMsg.style.display = "none", 2000);
}
});
input.addEventListener("keypress", (e) =&gt; {
if (e.key === 'Enter') btn.click();
});
}
}
const isUnlocked = localStorage.getItem(storageKey) === 'true';
render(isUnlocked);
el.parentNode.replaceChild(wrapper, el);
});
});
&lt;/script&gt;</description></item></channel></rss>